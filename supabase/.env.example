# Server-only template. Copy to an ignored .env.local and fill locally.
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected by hosted Supabase.
PUSH_DISPATCH_SECRET=REPLACE_WITH_A_RANDOM_32_BYTE_SECRET
FCM_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"YOUR_FIREBASE_PROJECT","client_email":"YOUR_SERVICE_ACCOUNT_EMAIL","private_key":"YOUR_PRIVATE_KEY_WITH_ESCAPED_NEWLINES"}
